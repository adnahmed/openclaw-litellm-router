{
  "agents": {
    "defaults": {
      "model": {
        "primary": "litellm/openclaw-main",
        "fallbacks": []
      },
      "imageModel": {
        "primary": "litellm/openclaw-main",
        "fallbacks": []
      },
      "models": {
        "litellm/openclaw-main": {
          "alias": "openclaw-main"
        }
      },
      "compaction": {
        "mode": "safeguard",
        "model": "litellm/openclaw-main"
      }
    }
  },
  "models": {
    "mode": "merge",
    "providers": {
      "litellm": {
        "baseUrl": "http://localhost:4000",
        "api": "openai-completions",
        "apiKey": {
          "source": "env",
          "provider": "default",
          "id": "LITELLM_API_KEY"
        },
        "models": [
          {
            "id": "openclaw-main",
            "name": "LiteLLM Router - OpenClaw Main Pool",
            "contextWindow": 32000,
            "maxTokens": 8192,
            "input": ["text", "image"],
            "reasoning": true
          }
        ]
      }
    }
  }
}
